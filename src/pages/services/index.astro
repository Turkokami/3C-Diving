      grid-template-columns: repeat(2, 1fr);
    }
  }

  .spoke-list li {
    margin: 0;
  }

  .spoke-list a,
  .spoke-list .pending {
    display: block;
    height: 100%;
    padding: var(--s-4);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .spoke-list a {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    color: var(--c-navy-700);
  }

  .spoke-list a:hover {
    border-color: var(--c-steel-500);
    background: var(--c-steel-100);
  }

  .spoke-list .pending {
    border: 1px dashed var(--c-line);
    color: var(--c-muted);
  }

  .spoke-list strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    line-height: var(--lh-snug);
  }

  .rolled {
    display: block;
    margin-top: var(--s-2);
    font-size: var(--t-xs);
    color: var(--c-muted);
    text-transform: lowercase;
  }

  .build-note {
    padding: var(--s-4);
    background: var(--c-surface);
    border-left: 4px solid var(--c-steel-300);
