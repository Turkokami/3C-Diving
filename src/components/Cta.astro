---
/**
 * Cta — the market-named call to action. Keystone dimension 8.
 *
 * Baseline scored 2/5 partly for a generic CTA. `market` defaults to the primary
 * market but every page passes its own, so a Port Isabel page says Port Isabel.
 * That single substitution is what separates a CTA from a banner.
 *
 * Emergency variant strips everything except the call — a vessel taking on water
 * is not going to fill in a form.
 */
import { business, napPhone } from '../data/business.ts';
import { routeExists } from '../lib/routes.ts';

// The quote form is a Phase 2 page (and P1-3: its endpoint still needs confirming).
// Until it exists the CTA is call-only rather than pointing at a 404.
const quoteLive = routeExists('/contact/');

const {
  heading,
  body,
  market = business.primaryMarket,
  variant = 'default',
} = Astro.props as {
  heading?: string;
  body?: string;
  market?: string;
  variant?: 'default' | 'emergency';
};

const nap = napPhone();
const isEmergency = variant === 'emergency';

const resolvedHeading =
  heading ?? (isEmergency ? 'Underwater emergency right now?' : `Need divers in ${market}?`);

const resolvedBody =
  body ??
  (isEmergency
    ? 'Call the line below. Tell us the vessel, the berth and what you are seeing, and we will tell you what we can mobilise and when.'
    : `Tell us the vessel, the berth and the problem. We will come back with scope, method and what we can have in the water — no obligation.`);
---

<section class={`cta ${isEmergency ? 'cta-emergency' : ''}`} aria-labelledby="cta-heading">
  <div class="cta-inner">
    <div>
      <h2 id="cta-heading">{resolvedHeading}</h2>
      <p>{resolvedBody}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary" href={nap.href}>Call {nap.display}</a>
      {
        !isEmergency && quoteLive && (
          <a class="btn btn-secondary" href="/contact/">
            Request a quote
          </a>
        )
      }
      <a class="cta-es" href={business.phoneSpanish.href} lang="es">
        ¿Prefiere español? {business.phoneSpanish.display}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--fill-2);
    border: 1px solid var(--c-border);
    color: var(--c-muted);
    border-radius: var(--radius-xl);
    padding: var(--s-7) var(--s-6);
    margin-top: var(--s-8);
    box-shadow: var(--edge-hi), var(--elev-3), var(--bloom);
  }

  /* A light source above the panel, rather than a flat fill. */
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      620px 260px at 22% -30%,
      rgba(255, 255, 255, 0.14),
      transparent 70%
    );
  }

  .cta-emergency {
    border-color: rgba(201, 140, 77, 0.55);
    box-shadow: var(--edge-hi), var(--elev-3), var(--bloom-copper);
  }

  .cta-emergency::before {
    background: radial-gradient(
      620px 260px at 22% -30%,
      rgba(201, 140, 77, 0.24),
      transparent 70%
    );
  }

  .cta-inner {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  @media (min-width: 820px) {
    .cta-inner {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--s-6);
    }
  }

  .cta h2 {
    color: var(--c-text);
    margin-top: 0;
    margin-bottom: var(--s-3);
    font-size: var(--t-2xl);
    letter-spacing: -0.02em;
  }

  .cta p {
    margin: 0;
    color: var(--c-muted);
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    align-items: stretch;
  }

  .cta-es {
    color: var(--c-muted-2);
    font-family: var(--font-ui);
    font-size: var(--t-sm);
    text-align: center;
    text-decoration: none;
  }
  .cta-es:hover {
    color: var(--c-text);
    text-decoration: underline;
  }
</style>
