---
/**
 * Faq — visible FAQ block. Universal contract block 5, defect P0-8.
 *
 * SINGLE SOURCE WITH THE SCHEMA. The page passes ONE `faqs` array to BaseLayout;
 * BaseLayout renders it here and feeds the identical array to the FAQPage node.
 * A visible FAQ that disagrees with its markup is a manual-action risk, and the
 * only reliable way to prevent it is to make a second source impossible.
 *
 * Native <details> — no JS, no hydration, keyboard accessible, and the answer
 * text is in the DOM for crawlers whether or not it is expanded.
 */
import type { Faq } from '../lib/schema.ts';

const { faqs, heading = 'Frequently asked questions' } = Astro.props as {
  faqs: Faq[];
  heading?: string;
};
---

{
  faqs.length > 0 && (
    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">{heading}</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{f.question}</summary>
            <div class="faq-answer">
              <p>{f.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq {
    margin-top: var(--s-7);
  }

  .faq-list {
    max-width: var(--w-prose);
    display: grid;
    gap: var(--s-3);
  }

  .faq-item {
    background: var(--fill-1);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    box-shadow: var(--edge), var(--elev-1);
    padding: 0 var(--s-5);
    transition: border-color 0.22s var(--ease), background 0.22s var(--ease),
      box-shadow 0.22s var(--ease);
  }

  .faq-item:hover {
    border-color: var(--c-border-hi);
  }

  .faq-item[open] {
    background: var(--fill-2);
    border-color: var(--c-border-hi);
    box-shadow: var(--edge-hi), var(--elev-2), var(--bloom);
  }

  summary {
    cursor: pointer;
    padding: var(--s-4) var(--s-6) var(--s-4) 0;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    color: var(--c-text);
    line-height: var(--lh-snug);
    list-style: none;
    position: relative;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    position: absolute;
    right: 2px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -6px;
    border-right: 2px solid var(--c-copper-l);
    border-bottom: 2px solid var(--c-copper-l);
    transform: rotate(45deg);
    transition: transform 0.25s var(--ease);
  }

  .faq-item[open] summary::after {
    transform: rotate(-135deg);
    margin-top: -2px;
  }

  .faq-answer {
    padding-bottom: var(--s-5);
    border-top: 1px solid var(--c-border-soft);
    padding-top: var(--s-4);
  }
  .faq-answer p {
    margin: 0;
  }
</style>
