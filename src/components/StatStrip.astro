---
/**
 * StatStrip — the verified numbers, given weight.
 *
 * EVERY FIGURE HERE IS SOURCED IN docs/RESEARCH-NOTES.md. Not one is about
 * 3rd Coast's own scale, because that is exactly the sort of number a contractor
 * site invents ("500+ jobs completed", "20 years experience") and this build does
 * not invent anything (doctrine #6). These are facts about the PORT — the channel
 * depth, the recycling share, the fleet size — which are verifiable, genuinely
 * useful to the reader, and demonstrate that we know the market cold.
 *
 * That distinction is the whole point. It is a trust device that costs nothing in
 * honesty: a buyer who reads "52 ft since June 2026" knows immediately that
 * whoever wrote this follows the port. Company stats go in here the day the owner
 * supplies them (questionnaire Section C/D), and not before.
 */

interface Stat {
  value: string;
  unit?: string;
  label: string;
}

const { stats, note } = Astro.props as { stats: Stat[]; note?: string };
---

<section class="stats" aria-label="Port of Brownsville at a glance">
  <ul>
    {
      stats.map((s) => (
        <li>
          <span class="stat-value display">
            {s.value}
            {s.unit && <span class="stat-unit">{s.unit}</span>}
          </span>
          <span class="stat-label">{s.label}</span>
        </li>
      ))
    }
  </ul>
  {note && <p class="stats-note">{note}</p>}
</section>

<style>
  .stats {
    margin: var(--s-7) 0;
  }

  .stats ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(2, 1fr);
    /* The 1px gap plus this background IS the divider grid — no borders needed. */
    background: var(--c-border-soft);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--edge), var(--elev-2);
  }

  @media (min-width: 860px) {
    .stats ul {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats li {
    margin: 0;
    padding: var(--s-6) var(--s-4);
    background: linear-gradient(180deg, rgba(26, 28, 33, 0.92), rgba(13, 14, 16, 0.92));
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    text-align: center;
    align-items: center;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 3.1rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-unit {
    font-size: 0.46em;
    letter-spacing: 0.02em;
    margin-left: 0.12em;
  }

  .stat-label {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    line-height: 1.5;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    color: var(--c-muted-2);
    max-width: 20ch;
    text-wrap: balance;
  }

  .stats-note {
    margin: var(--s-3) 0 0;
    font-family: var(--font-ui);
    font-size: var(--t-xs);
    color: var(--c-muted-2);
    max-width: none;
  }
</style>
