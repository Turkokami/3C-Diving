---
/**
 * AnswerBox — the Quick Answer. Keystone M2/M4, universal contract block 1.
 *
 * Defect P0-8: the live site has no AEO layer at all. This is the cheapest win
 * available and it is entirely absent.
 *
 * THE RULE OF ONE SOURCE. The same 40–60 words are used three times:
 *   1. rendered here, directly under the H1
 *   2. reused verbatim as the meta description
 *   3. targeted by `speakable` in the WebPage node (`.answer-box`)
 * Pages pass `answer` to BaseLayout, which does all three. A page never writes
 * the answer twice, so the spoken answer and the visible answer cannot diverge.
 *
 * The 40–60 word band is enforced by the SEO auditor, not by hope.
 */
const { answer, label = 'Quick answer' } = Astro.props as {
  answer: string;
  label?: string;
};
---

<div class="answer-box">
  <p class="answer-label">{label}</p>
  <p class="answer-text">{answer}</p>
</div>

<style>
  .answer-box {
    position: relative;
    background: var(--fill-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: var(--s-5) var(--s-6);
    margin: 0 0 var(--s-7);
    max-width: var(--w-prose);
    box-shadow: var(--edge), var(--elev-2), var(--bloom);
    overflow: hidden;
  }

  /* A copper filament down the leading edge, fading at both ends. */
  .answer-box::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10%;
    bottom: 10%;
    width: 3px;
    border-radius: 3px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--c-copper-l),
      var(--c-copper-d),
      transparent
    );
    box-shadow: 0 0 18px rgba(201, 140, 77, 0.55);
  }

  .answer-label {
    margin: 0 0 var(--s-3);
    font-family: var(--font-ui);
    font-size: var(--t-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.19em;
    color: var(--c-copper-l);
  }

  .answer-text {
    margin: 0;
    font-size: var(--t-xl);
    line-height: 1.45;
    color: #fff;
    letter-spacing: -0.008em;
  }
</style>
