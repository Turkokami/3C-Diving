---
/**
 * Header — global nav + the NAP phone.
 *
 * Every nav target is a real, server-rendered URL. The live site's `#anchor` nav
 * is defect P0-1: fragments never reach the server, so they cannot rank, cannot
 * be canonical and cannot carry their own title or schema. Nothing in this file
 * may ever be an in-page fragment.
 */
import { business, napPhone } from '../data/business.ts';
import { liveLinks } from '../lib/routes.ts';
import { logo } from '../data/media.ts';

const { currentPath = '/' } = Astro.props as { currentPath?: string };
const nap = napPhone();

/**
 * The full nav as it will look at launch. `liveLinks` drops any entry whose page
 * has not been built yet, so this list can be written once, now, and simply fills
 * in as Phases 2–5 land — without ever shipping a 404 in the global nav.
 */
const nav = liveLinks([
  { name: 'Services', href: '/services/' },
  { name: 'Locations', href: '/locations/' },
  { name: 'Industries', href: '/commercial/' },
  { name: 'Compliance', href: '/compliance/' },
  { name: 'About', href: '/about/' },
  { name: 'Contact', href: '/contact/' },
]);

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${business.name} — home`}>
      <img
        class="brand-mark"
        src={logo.src}
        alt=""
        width="48"
        height="48"
        loading="eager"
        decoding="async"
      />
      <span class="brand-text">
        <strong>3rd Coast</strong>
        <span>Commercial Diving &amp; Salvage</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header-phone" href={nap.href}>
      <span class="header-phone-label">Call 24/7</span>
      <span class="header-phone-number">{nap.display}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    background: rgba(13, 14, 16, 0.86);
    backdrop-filter: blur(10px);
    color: var(--c-text);
    border-bottom: 1px solid var(--c-border);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
    padding-block: var(--s-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--c-text);
    text-decoration: none;
    margin-right: auto;
  }

  /* The real emblem. alt="" because the adjacent brand text says the same thing —
     announcing it twice is noise for a screen reader. */
  .brand-mark {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex: none;
    border: 1px solid var(--c-border);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-text strong {
    font-family: var(--font-display);
    font-size: var(--t-lg);
  }
  .brand-text span {
    font-size: var(--t-xs);
    color: var(--c-muted-2);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .nav-list li {
    margin: 0;
  }
  .nav-list a {
    color: var(--c-muted);
    text-decoration: none;
    font-size: var(--t-sm);
    font-weight: 600;
    padding-block: var(--s-2);
    display: inline-block;
  }
  .nav-list a:hover,
  .nav-list a[aria-current='page'] {
    color: var(--c-text);
    border-bottom: 2px solid var(--c-copper);
  }

  .header-phone {
    display: none;
    flex-direction: column;
    text-align: right;
    color: var(--c-text);
    text-decoration: none;
    line-height: 1.2;
  }
  .header-phone-label {
    font-size: var(--t-xs);
    color: var(--c-copper-l);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
  }
  .header-phone-number {
    font-family: var(--font-display);
    font-size: var(--t-lg);
  }

  @media (min-width: 900px) {
    .header-phone {
      display: flex;
    }
  }
</style>
