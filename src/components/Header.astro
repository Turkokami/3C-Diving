---
/**
 * Header — global nav + the NAP phone.
 *
 * Every nav target is a real, server-rendered URL. The live site's `#anchor` nav
 * is defect P0-1: fragments never reach the server, so they cannot rank, cannot
 * be canonical and cannot carry their own title or schema. Nothing in this file
 * may ever be an in-page fragment.
 */
import { business, napPhone } from '../data/business.ts';
import { liveLinks } from '../lib/routes.ts';
import { logo } from '../data/media.ts';

const { currentPath = '/' } = Astro.props as { currentPath?: string };
const nap = napPhone();

/**
 * The full nav as it will look at launch. `liveLinks` drops any entry whose page
 * has not been built yet, so this list can be written once, now, and simply fills
 * in as Phases 2–5 land — without ever shipping a 404 in the global nav.
 */
const nav = liveLinks([
  { name: 'Services', href: '/services/' },
  { name: 'Locations', href: '/locations/' },
  { name: 'Industries', href: '/commercial/' },
  { name: 'Compliance', href: '/compliance/' },
  { name: 'About', href: '/about/' },
  { name: 'Contact', href: '/contact/' },
]);

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${business.name} — home`}>
      <img
        class="brand-mark"
        src={logo.src}
        alt=""
        width="48"
        height="48"
        loading="eager"
        decoding="async"
      />
      <span class="brand-text">
        <strong class="wordmark"><span class="wm-num">3</span>rd&nbsp;Coast</strong>
        <span>Commercial Diving &amp; Salvage</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header-phone" href={nap.href}>
      <span class="header-phone-label">Call 24/7</span>
      <span class="header-phone-number">{nap.display}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    background: rgba(13, 14, 16, 0.86);
    backdrop-filter: blur(10px);
    color: var(--c-text);
    border-bottom: 1px solid var(--c-border);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
    padding-block: var(--s-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--c-text);
    text-decoration: none;
    margin-right: auto;
  }

  /* The real emblem. alt="" because the adjacent brand text says the same thing —
     announcing it twice is noise for a screen reader. */
  .brand-mark {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    flex: none;
    border: 1px solid var(--c-border-hi);
    box-shadow: 0 0 22px rgba(255, 255, 255, 0.1), var(--elev-1);
    /* The emblem is dark pewter on black; lift it so it reads on the bar. */
    filter: brightness(1.35) contrast(1.12);
    transition: box-shadow 0.3s var(--ease), transform 0.3s var(--ease),
      filter 0.3s var(--ease);
  }

  .brand:hover .brand-mark {
    box-shadow: 0 0 34px rgba(255, 255, 255, 0.22), var(--elev-2);
    transform: scale(1.04);
    filter: brightness(1.55) contrast(1.15);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-text strong {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    letter-spacing: -0.015em;
  }
  .brand-text span {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--c-muted-2);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .nav-list li {
    margin: 0;
  }
  .nav-list a {
    position: relative;
    color: var(--c-muted);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.01em;
    padding-block: var(--s-3);
    display: inline-block;
    transition: color 0.2s var(--ease);
  }

  /* Underline grows from the centre and glows. */
  .nav-list a::after {
    content: '';
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: 6px;
    height: 2px;
    border-radius: 2px;
    background: var(--c-copper-l);
    box-shadow: 0 0 12px rgba(201, 140, 77, 0.85);
    transition: left 0.25s var(--ease), right 0.25s var(--ease);
  }

  .nav-list a:hover::after,
  .nav-list a[aria-current='page']::after {
    left: 0;
    right: 0;
  }
  .nav-list a:hover,
  .nav-list a[aria-current='page'] {
    color: var(--c-text);
  }

  .header-phone {
    display: none;
    flex-direction: column;
    text-align: right;
    color: var(--c-text);
    text-decoration: none;
    line-height: 1.2;
  }
  .header-phone-label {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    color: var(--c-copper-l);
    text-transform: uppercase;
    letter-spacing: 0.17em;
    font-weight: 700;
  }
  .header-phone-number {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    letter-spacing: -0.01em;
    transition: text-shadow 0.25s var(--ease);
  }
  .header-phone:hover .header-phone-number {
    text-shadow: 0 0 22px rgba(255, 255, 255, 0.45);
  }

  @media (min-width: 900px) {
    .header-phone {
      display: flex;
    }
  }
</style>
